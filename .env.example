# =====================================================================
# AI PR Review Agent Environment Configuration
# =====================================================================

# --- LLM Settings (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- GitHub App / API Credentials ---
# For live webhook & PR reviews. (Optional if running in local simulator mode)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Vector Database (Qdrant) ---
# Set QDRANT_URL=:memory: for instant zero-dependency in-memory vector storage
# Or use http://localhost:6333 when running via Docker
QDRANT_URL=:memory:
QDRANT_API_KEY=

# --- Graph Database (Neo4j) ---
# If NEO4J_URI is empty or connection fails, automatically falls back to in-memory NetworkX code graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prreviewpassword

# --- Redis (Job Queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres (Checkpointer & State) ---
# If empty, LangGraph uses MemorySaver checkpointer for zero-dependency local runs
DATABASE_URL=

# --- Observability (Optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
